{# Cloudflare Turnstile widget (turnstile Stimulus controller), posting its token as field_name. #}
<div class="turnstile"
     data-controller="turnstile"
     data-turnstile-site-key-value="{{ site_key }}"
     data-turnstile-field-name-value="{{ field_name }}">
    <div data-turnstile-target="widget"></div>
    <p class="turnstile-error" data-turnstile-target="error" role="alert" hidden></p>
</div>
<noscript><p class="form-help">Please turn on JavaScript to send this form.</p></noscript>
