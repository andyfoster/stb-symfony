{% extends 'account/_layout.html.twig' %}

{% block title %}Messages · ScarfieTextbooks{% endblock %}

{% block account %}
    <h1 class="dashboard-title">Messages <span class="count">{{ messages|length }}</span></h1>

    {% if messages|length %}
        {{ include('account/_message_list.html.twig') }}
    {% else %}
        <div class="empty-state">
            <h3>No messages yet.</h3>
            <p>When someone asks about one of your listings, it shows up here and in your email.</p>
        </div>
    {% endif %}
{% endblock %}
