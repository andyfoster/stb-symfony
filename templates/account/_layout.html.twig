{% extends 'base.html.twig' %}

{#
 # Everything about your account sits in this dashboard, with the sidebar
 # on every page. Pages fill the "account" block.
 #}
{% block body %}
    {% set route = app.request.attributes.get('_route') %}
    {% set unread = unread_message_count() %}
    <div class="dashboard">
        <nav class="dashboard-nav" aria-label="Your account">
            <p class="dashboard-user">
                <strong>{{ app.user.displayName }}</strong>
                <span>{{ app.user.email }}</span>
            </p>
            <ul>
                <li><a href="{{ path('app_account_listings') }}" {{ route == 'app_account_listings' ? 'aria-current="page"' }}>My listings</a></li>
                <li><a href="{{ path('app_account_messages') }}" {{ route starts with 'app_account_message' ? 'aria-current="page"' }}>Messages{% if unread %} <span class="nav-badge">{{ unread }}</span>{% endif %}</a></li>
                <li><a href="{{ path('app_account') }}" {{ route == 'app_account' ? 'aria-current="page"' }}>Account</a></li>
            </ul>
            <a class="button button-small dashboard-post" href="{{ path('app_listing_new') }}">Post a listing</a>
        </nav>
        <div class="dashboard-main">
            {% block account %}{% endblock %}
        </div>
    </div>
{% endblock %}
