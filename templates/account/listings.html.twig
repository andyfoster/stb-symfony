{% extends 'account/_layout.html.twig' %}
{% import 'listing/_macros.html.twig' as m %}

{% block title %}My listings · ScarfieTextbooks{% endblock %}

{% block account %}
    <h1 class="dashboard-title">My listings <span class="count">{{ listings|length }}</span></h1>

    {% for listing in listings %}
        {% set state = listing.draft ? 'draft' : (listing.sold ? 'sold' : (listing.expired ? 'expired' : 'live')) %}
        <article class="my-listing my-listing-{{ state }}">
            <div class="my-listing-main">
                <span class="status status-{{ state }}">{{ state|capitalize }}</span>
                <h2><a href="{{ path('app_listing_show', {id: listing.id}) }}">{{ listing.title }}</a></h2>
                <p class="muted my-listing-meta">
                    <span>{{ m.price(listing) }}</span>
                    <span>{{ listing.category.label }}</span>
                    {% if state == 'live' %}<span>Expires {{ listing.expiresAt|date('j M Y') }}</span>
                    {% elseif state == 'expired' %}<span>Expired {{ listing.expiresAt|date('j M Y') }}</span>{% endif %}
                </p>
            </div>
            <div class="my-listing-actions">
                {% if listing.canRefresh %}
                    <form method="post" action="{{ path('app_listing_refresh', {id: listing.id}) }}">
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                        <button class="button button-small" type="submit">Refresh</button>
                    </form>
                {% endif %}
                <a class="button button-small button-outline" href="{{ path('app_listing_edit', {id: listing.id}) }}">{{ listing.draft ? 'Edit & publish' : (listing.sold ? 'Re-list' : 'Edit') }}</a>
                {% if not listing.draft and not listing.sold %}
                    <form method="post" action="{{ path('app_listing_sold', {id: listing.id}) }}">
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                        <button class="nav-link" type="submit">{{ listing.type.value == 'wanted' ? 'Found it' : 'Mark sold' }}</button>
                    </form>
                {% endif %}
                <form method="post" action="{{ path('app_listing_delete', {id: listing.id}) }}" data-turbo-confirm="Delete “{{ listing.title }}”? This can’t be undone.">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                    <button class="nav-link danger-link" type="submit">Delete</button>
                </form>
            </div>
        </article>
    {% else %}
        <div class="empty-state">
            <h3>You haven’t posted anything yet.</h3>
            <p>Sell a textbook, or tell people what you’re looking for.</p>
            <a class="button" href="{{ path('app_listing_new') }}">Post a listing</a>
        </div>
    {% endfor %}

    {% if listings|length %}
        <p class="form-help account-note">Choose or extend your hide date from Edit. <a href="{{ path('app_about') }}">How it works</a></p>
    {% endif %}
{% endblock %}
