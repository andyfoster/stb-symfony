{% extends 'emails/_layout.html.twig' %}
{% block content %}
<p>{{ message.name }} ({{ message.email }}) sent a message from the contact form on <a href="{{ url('app_about') }}">ScarfieTextbooks</a>:</p>

<blockquote style="margin:16px 0;padding:12px 16px;border-left:3px solid #0b3a9f;background:#eef3fd">{{ message.body|nl2br }}</blockquote>

<p>Reply to this email to answer them.</p>
{% endblock %}
