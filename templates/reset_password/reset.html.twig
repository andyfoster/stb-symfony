{% extends 'base.html.twig' %}

{% block title %}Choose a new password · ScarfieTextbooks{% endblock %}

{% block body %}
    <div class="form-page col-12 col-md-8 col-lg-5 mx-auto py-4">
        <div class="form-heading mb-4">
            <h1>Choose a new password</h1>
        </div>

        {{ form_start(form, {attr: {class: 'form-panel card card-body p-4', novalidate: 'novalidate'}}) }}
            <div class="form-field mb-3">{{ form_row(form.plainPassword.first) }}</div>
            <div class="form-field mb-3">{{ form_row(form.plainPassword.second) }}</div>
            <div class="form-actions d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
                <a class="link-secondary" href="{{ path('app_login') }}">Cancel</a>
                <button class="button btn btn-primary" type="submit">Change password</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
