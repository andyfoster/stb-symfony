{% extends 'base.html.twig' %}

{% block title %}Reset your password · ScarfieTextbooks{% endblock %}

{% block body %}
    <div class="form-page col-12 col-md-8 col-lg-5 mx-auto py-4">
        <div class="form-heading mb-4">
            <h1>Reset your password</h1>
            <p>Enter the email you signed up with and we’ll send you a link to choose a new password.</p>
        </div>

        {{ form_start(form, {attr: {class: 'form-panel card card-body p-4', novalidate: 'novalidate'}}) }}
            <div class="form-field mb-3">{{ form_row(form.email) }}</div>
            <div class="form-actions d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
                <a class="link-secondary" href="{{ path('app_login') }}">Cancel</a>
                <button class="button btn btn-primary" type="submit">Send reset link</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
