{# The create/edit listing form: details on the left, photos on the right. #}
{{ form_start(form, {attr: {
    class: 'listing-form',
    novalidate: 'novalidate',
    'data-controller': 'listing-form',
    'data-listing-form-textbooks-value': 'textbooks',
}}) }}
    <div class="listing-form-main form-panel">
        <div class="form-field type-choice">{{ form_row(form.type) }}</div>

        <div class="form-field">{{ form_row(form.title, {attr: {'data-listing-form-target': 'title', 'data-action': 'listing-form#score'}}) }}</div>

        <div class="form-grid">
            <div class="form-field">{{ form_row(form.category, {attr: {'data-listing-form-target': 'category', 'data-action': 'listing-form#toggleBook'}}) }}</div>
            <div class="form-field">
                {{ form_label(form.priceCents) }}
                <div class="input-prefix"><span aria-hidden="true">$</span>{{ form_widget(form.priceCents) }}</div>
                {{ form_help(form.priceCents) }}
                {{ form_errors(form.priceCents) }}
            </div>
        </div>

        <fieldset class="book-fields" data-listing-form-target="book" data-controller="isbn-lookup" data-isbn-lookup-url-value="{{ path('app_listing_isbn_lookup') }}">
            <legend>Textbook details</legend>
            <div class="form-field">
                {{ form_label(form.book.isbn) }}
                <div class="input-with-button">
                    {{ form_widget(form.book.isbn, {attr: {'data-isbn-lookup-target': 'isbn', 'data-action': 'keydown.enter->isbn-lookup#lookup:prevent'}}) }}
                    <button class="button button-small button-outline" type="button" data-action="isbn-lookup#lookup" data-isbn-lookup-target="button">Look up</button>
                </div>
                <p class="lookup-status" data-isbn-lookup-target="status" role="status" aria-live="polite"></p>
                {{ form_help(form.book.isbn) }}
                {{ form_errors(form.book.isbn) }}
            </div>
            <div class="form-field">{{ form_row(form.book.author, {attr: {'data-isbn-lookup-target': 'author'}}) }}</div>
            <div class="form-field field-narrow">{{ form_row(form.book.edition, {attr: {'data-isbn-lookup-target': 'edition'}}) }}</div>
            <div class="form-field" data-controller="paper-tags" data-paper-tags-url-value="{{ path('app_paper_search') }}">
                {{ form_label(form.book.papers) }}
                {{ form_widget(form.book.papers, {attr: {'data-paper-tags-target': 'input'}}) }}
                {{ form_help(form.book.papers) }}
                {{ form_errors(form.book.papers) }}
            </div>
        </fieldset>

        <div class="form-grid">
            <div class="form-field">{{ form_row(form.condition, {attr: {'data-listing-form-target': 'condition', 'data-action': 'listing-form#score'}}) }}</div>
            <div class="form-field">{{ form_row(form.location) }}</div>
        </div>

        <div class="form-field">{{ form_row(form.description, {attr: {'data-listing-form-target': 'description', 'data-action': 'listing-form#score'}}) }}</div>
    </div>

    <div class="listing-form-side">
        <div class="form-panel photo-panel" data-controller="photo-slots" data-photo-slots-max-value="{{ constant('App\\Entity\\Listing::MAX_PHOTOS') }}" data-photo-slots-existing-value="{{ listing.photos|length }}" data-action="photo-slots:changed->listing-form#score">
            {{ form_label(form.photos) }}
            {{ form_widget(form.photos, {attr: {'data-photo-slots-target': 'input'}}) }}
            {{ form_errors(form.photos) }}

            <div class="photo-slots">
                {% for photo in listing.photos %}
                    <div class="photo-slot photo-slot-filled">
                        <img src="{{ path('app_photo', {id: photo.id, size: 'thumb'}) }}" alt="Photo {{ loop.index }}">
                        {% if form.children.removePhotos is defined %}
                            <label class="photo-remove">{{ form_widget(form.removePhotos[loop.index0], {attr: {'data-action': 'photo-slots#preview'}}) }} Remove</label>
                        {% endif %}
                    </div>
                {% endfor %}
                {% for i in (listing.photos|length + 1)..constant('App\\Entity\\Listing::MAX_PHOTOS') %}
                    <label class="photo-slot photo-slot-empty" for="{{ form.photos.vars.id }}" data-photo-slots-target="slot" data-action="dragover->photo-slots#dragOver dragleave->photo-slots#dragLeave drop->photo-slots#drop">
                        <span>Add photo</span>
                    </label>
                {% endfor %}
            </div>
            <p class="form-help">JPEG, PNG or WebP, up to 10 MB each. We strip location data from photos.</p>
            {% if not app.user.verified %}
                <p class="form-help photo-warning">Your photos stay hidden from other people until you confirm your email address.</p>
            {% endif %}
        </div>

        <div class="quality-hint" data-listing-form-target="quality" aria-live="polite">
            <strong>Quality score:</strong> <span data-listing-form-target="qualityText">Add a clear title, 3+ photos, and condition to improve ranking.</span>
        </div>
    </div>

    <div class="listing-form-actions">
        {{ form_widget(form.publish, {attr: {class: 'button'}}) }}
        {{ form_widget(form.saveDraft, {attr: {class: 'button button-outline'}}) }}
        {% if listing.id %}<a class="cancel-link" href="{{ path('app_listing_show', {id: listing.id}) }}">Cancel</a>{% endif %}
    </div>
{{ form_end(form) }}
