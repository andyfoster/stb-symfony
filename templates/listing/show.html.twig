{% extends 'base.html.twig' %}
{% import 'listing/_macros.html.twig' as m %}

{# For the seller (and admins): where the listing stands, and what they can do about it. #}
{% macro owner_status(listing, own) %}
    {% set state = listing.draft ? 'draft' : (listing.sold ? 'sold' : (listing.expired ? 'expired' : 'live')) %}
    <section class="owner-bar" aria-labelledby="owner-title">
        <div class="owner-summary">
            <h2 id="owner-title">{{ own ? 'Your listing' : 'Manage listing' }}</h2>
            <p class="owner-status">
            <span class="status status-{{ state }}">{{ state|capitalize }}</span>
            {% if state == 'draft' %}Only you can see it.
            {% elseif state == 'sold' %}Hidden from everyone else.
            {% elseif state == 'expired' %}Since {{ listing.expiresAt|date('j M Y') }}.
            {% else %}Until {{ listing.expiresAt|date('j M Y') }}.{% endif %}
            </p>
        </div>
        <div class="owner-actions">
            <a class="button button-small" href="{{ path('app_listing_edit', {id: listing.id}) }}">{{ state == 'draft' ? 'Edit & publish' : 'Edit listing' }}</a>
            {% if listing.canRefresh %}
                <form method="post" action="{{ path('app_listing_refresh', {id: listing.id}) }}">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                    <button class="button button-small button-outline" type="submit">Refresh</button>
                </form>
            {% endif %}
        </div>
        {% if listing.photos|length and not listing.arePhotosPublic %}
            <p class="photo-notice">Your photos are hidden from other people until you confirm your email address.</p>
        {% endif %}
    </section>
{% endmacro %}

{% block title %}{{ listing.title }} · ScarfieTextbooks{% endblock %}

{% block body %}
    {% set wanted = listing.type.value == 'wanted' %}
    {% set owner = is_granted('LISTING_EDIT', listing) %}
    {% set photos = listing.arePhotosPublic or owner ? listing.photos : [] %}

    <div class="listing-page">
        {% if owner %}{{ _self.owner_status(listing, listing.seller and listing.seller.id == app.user.id) }}{% endif %}
        <div class="listing-layout">
            <article class="listing-detail">
                <p class="listing-kicker">{{ listing.category.label }}{% if wanted %} <span class="badge badge-wanted">Wanted</span>{% endif %}</p>
                <h1>{{ listing.title }}</h1>
                <p class="listing-price">{{ m.price(listing) }}</p>

                {% if photos|length %}
                    <div class="gallery" data-controller="gallery">
                        {% for photo in photos %}
                            <a class="gallery-item" href="{{ path('app_photo', {id: photo.id, size: 'large'}) }}" data-gallery-target="item" data-action="gallery#open" data-gallery-index-param="{{ loop.index0 }}">
                                <img src="{{ path('app_photo', {id: photo.id, size: 'thumb'}) }}" alt="Photo {{ loop.index }} of {{ listing.title }}">
                            </a>
                        {% endfor %}

                        <dialog class="lightbox" data-gallery-target="dialog" data-action="click->gallery#backdrop keydown->gallery#key" aria-label="Photos of {{ listing.title }}">
                            <img data-gallery-target="image" alt="">
                            {% if photos|length > 1 %}
                                <button class="lightbox-nav lightbox-prev" type="button" data-action="gallery#previous" aria-label="Previous photo">‹</button>
                                <button class="lightbox-nav lightbox-next" type="button" data-action="gallery#next" aria-label="Next photo">›</button>
                                <p class="lightbox-count" data-gallery-target="count"></p>
                            {% endif %}
                            <button class="lightbox-close" type="button" data-action="gallery#close" aria-label="Close">×</button>
                        </dialog>
                    </div>
                {% endif %}

                <dl class="listing-facts">
                    {% if listing.book %}
                        <div><dt>Author</dt><dd>{{ listing.book.author }}</dd></div>
                        {% if listing.book.edition %}<div><dt>Edition</dt><dd>{{ listing.book.edition }}</dd></div>{% endif %}
                        {% if listing.book.isbn %}<div><dt>ISBN</dt><dd>{{ listing.book.isbn }}</dd></div>{% endif %}
                        {% if listing.book.papers|length %}<div><dt>{{ listing.book.papers|length > 1 ? 'Papers' : 'Paper' }}</dt><dd class="paper-list">{% for paper in listing.book.papers %}<span><span class="course-code">{{ paper.code }}</span>{% if paper.title %} {{ paper.title }}{% endif %}</span>{% endfor %}</dd></div>{% endif %}
                    {% endif %}
                    {% if listing.condition %}<div><dt>Condition</dt><dd>{{ listing.condition.label }}<span class="condition-detail">{{ listing.condition.description }}</span></dd></div>{% endif %}
                    {% if listing.publishedAt %}<div><dt>Listed</dt><dd><time datetime="{{ listing.publishedAt|date('c') }}">{{ listing.publishedAt|date('j M Y') }}</time></dd></div>{% endif %}
                </dl>

                {% if listing.description %}
                    <div class="listing-body">{{ listing.description|nl2br }}</div>
                {% endif %}
            </article>

            <aside class="contact-panel" aria-labelledby="contact-title">
                {% set seller = listing.seller %}
                {% if seller is null %}
                    <h2 id="contact-title">Contact</h2>
                    <p class="muted">This listing was imported from the old site and can’t be contacted here.</p>
                {% else %}
                    <h2 id="contact-title">{{ wanted ? 'Got one?' : 'Interested?' }} Message {{ seller.displayName }}</h2>

                    {% if seller.publicPhone %}
                        <div class="phone-reveal" data-controller="reveal">
                            <button class="button button-outline" type="button" data-action="reveal#show" data-reveal-target="button">Show phone number</button>
                            <a class="phone-number" href="tel:{{ seller.publicPhone|replace({' ': '', '(': '', ')': '', '-': ''}) }}" data-reveal-target="content" hidden>{{ seller.publicPhone }}</a>
                        </div>
                    {% endif %}

                    {% if owner and seller.id == app.user.id %}
                        <button class="button contact-open" type="button" disabled>Message {{ seller.displayName }}</button>
                        <p class="form-help">{{ listing.live ? 'Buyers can message you here. They’ll get your reply by email.' : 'Buyers can message you here once your listing is live.' }}</p>
                    {% elseif listing.live %}
                        {# Opens by itself when the form comes back with something to fix. #}
                        <div data-controller="modal" data-modal-open-value="{{ contact.vars.submitted and not contact.vars.valid ? 'true' : 'false' }}">
                            <button class="button contact-open" type="button" data-action="modal#open">Message {{ seller.displayName }}</button>
                            <p class="form-help">They’ll get it by email and reply to you directly.</p>

                            <dialog class="modal" data-modal-target="dialog" data-action="click->modal#backdrop" aria-labelledby="contact-modal-title">
                                <div class="modal-header">
                                    <h2 id="contact-modal-title">Message {{ seller.displayName }}</h2>
                                    <button class="modal-close" type="button" data-action="modal#close" aria-label="Close">×</button>
                                </div>
                                <p class="muted modal-about">About “{{ listing.title }}”</p>
                                {{ form_start(contact, {attr: {class: 'contact-form', novalidate: 'novalidate'}}) }}
                                    <div class="form-grid">
                                        <div class="form-field">{{ form_row(contact.senderName) }}</div>
                                        <div class="form-field">{{ form_row(contact.senderEmail) }}</div>
                                    </div>
                                    <div class="form-field">{{ form_row(contact.body, {attr: {rows: 6}}) }}</div>
                                    {{ form_row(contact.website) }}
                                    {% if contact.children.captcha is defined %}<div class="form-field">{{ form_row(contact.captcha) }}</div>{% endif %}
                                    <div class="modal-actions">
                                        <button class="button contact-send" type="submit">Send message</button>
                                        <p class="form-help">Your email goes to the seller so they can reply. We don’t show it on the site.</p>
                                    </div>
                                {{ form_end(contact) }}
                            </dialog>
                        </div>
                    {% else %}
                        <p class="muted">This listing isn’t live, so it can’t be messaged.</p>
                    {% endif %}
                {% endif %}
            </aside>
        </div>
    </div>
{% endblock %}
