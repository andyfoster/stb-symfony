{% import 'listing/_macros.html.twig' as m %}
{% set wanted = listing.type.value == 'wanted' %}
{% set photo = listing.arePhotosPublic ? listing.photos|first : null %}
<article class="listing-card {{ wanted ? 'listing-wanted' : '' }}">
    {% if photo %}
        <img class="card-photo" src="{{ path('app_photo', {id: photo.id, size: 'thumb'}) }}" alt="" loading="lazy" width="96" height="96">
    {% else %}
        <span class="card-photo-none" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/><path d="M5 17a3 3 0 0 1 3-3h11"/></svg></span>
    {% endif %}

    <div class="card-main">
        <h3><a class="card-link" href="{{ path('app_listing_show', {id: listing.id}) }}" data-turbo-frame="_top">{{ listing.title }}</a></h3>
        {% if listing.book %}
            <p class="book-meta">
                {{ listing.book.author }}{% if listing.book.edition %} · {{ listing.book.edition }} edition{% endif %}
            </p>
        {% endif %}
        <div class="card-top">
            <span class="badge {{ wanted ? 'badge-wanted' : 'badge-sale' }}">{{ listing.type.label }}</span>
            {% if listing.book and listing.book.courseCode %}<span class="course-code">{{ listing.book.courseCode }}</span>{% else %}<span class="listing-category">{{ listing.category.label }}</span>{% endif %}
            {% if listing.condition %}<span class="listing-condition">{{ listing.condition.label }}</span>{% endif %}
        </div>
    </div>

    <div class="card-details">
        {% if listing.description %}<p class="listing-description">{{ listing.description }}</p>{% endif %}
        <div class="card-footer">
            {% if listing.location %}<span>{{ listing.location }}</span>{% endif %}
            {% set date = listing.publishedAt ?? listing.createdAt %}
            <time datetime="{{ date|date('c') }}">{{ date|date('j M Y') }}</time>
        </div>
    </div>

    <a class="price-button" href="{{ path('app_listing_show', {id: listing.id}) }}#contact-title" data-turbo-frame="_top" tabindex="-1">
        <span class="listing-price">{{ m.price(listing) }}</span>
        <span class="price-cta">{{ wanted ? 'I have one' : 'Message seller' }}</span>
    </a>
</article>
