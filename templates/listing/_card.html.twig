{% import 'listing/_macros.html.twig' as m %}
{% set wanted = listing.type.value == 'wanted' %}
{% set photo = listing.arePhotosPublic ? listing.photos|first : null %}
<article class="listing-card {{ wanted ? 'listing-wanted' : '' }}">
    {% if photo %}
        <img class="card-photo" src="{{ path('app_photo', {id: photo.id, size: 'thumb'}) }}" alt="" loading="lazy" width="80" height="80">
    {% else %}
        <span class="card-icon card-icon-{{ listing.category.value }}" title="{{ listing.category.label }}">{{ m.category_icon(listing.category) }}</span>
    {% endif %}

    <div class="card-main">
        <h3>
            <a class="card-link" href="{{ path('app_listing_show', {id: listing.id}) }}" data-turbo-frame="_top">{{ listing.title }}</a>
            {% if wanted %}<span class="badge badge-wanted">Wanted</span>{% endif %}
        </h3>
        <p class="book-meta">
            {% if listing.book %}
                <span>{{ listing.book.author }}</span>
                {% if listing.book.edition %}<span>{{ listing.book.edition }} edition</span>{% endif %}
            {% else %}
                <span>{{ listing.category.label }}</span>
            {% endif %}
        </p>
        {% if listing.description %}<p class="listing-description">{{ listing.description }}</p>{% endif %}
        {% set papers = listing.book ? listing.book.papers : [] %}
        {% if papers|length or listing.condition %}
            <p class="card-tags">
                {% for paper in papers %}<span class="course-code">{{ paper.code }}</span>{% endfor %}
                {% if listing.condition %}<span class="condition">{{ listing.condition.label }}</span>{% endif %}
            </p>
        {% endif %}
    </div>

    <div class="card-side">
        <p class="listing-price">{{ m.price(listing) }}</p>
        <p class="card-footer">
            {% if listing.location %}<span>{{ listing.location }}</span>{% endif %}
            {% set date = listing.publishedAt ?? listing.createdAt %}
            <time datetime="{{ date|date('c') }}">{{ date|date('j M') }}</time>
        </p>
    </div>
</article>
