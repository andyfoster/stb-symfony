{% macro money(cents) %}${{ (cents / 100)|number_format(cents % 100 ? 2 : 0) }}{% endmacro %}

{# "Make an offer", "Free", "$85", or "Budget up to $50" for wanted listings. #}
{% macro price(listing) %}
    {%- set wanted = listing.type.value == 'wanted' -%}
    {%- if listing.priceCents is null -%}
        {{ wanted ? 'Name your price' : 'Make an offer' }}
    {%- elseif listing.priceCents == 0 -%}
        Free
    {%- else -%}
        {% if wanted %}<span class="price-label">Budget up to</span> {% endif %}{{ _self.money(listing.priceCents) }}
    {%- endif -%}
{% endmacro %}


{# A simple line icon for each category, for listings without a photo. #}
{% macro category_icon(category) %}
    {%- set paths = {
        textbooks: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/><path d="M9 8h7"/>',
        course_gear: '<path d="M9 3h6"/><path d="M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9V3"/><path d="M7.5 15h9"/>',
        electronics: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
        furniture: '<path d="M6 11V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v6"/><path d="M4 11h16v5H4z"/><path d="M6 16v5M18 16v5"/>',
        flat_and_kitchen: '<path d="M4 10h16v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M2 10h20M9 6c0-1 1-1 1-2M14 6c0-1 1-1 1-2"/>',
        bikes_and_transport: '<circle cx="6" cy="16" r="4"/><circle cx="18" cy="16" r="4"/><path d="M6 16l4-8h5l3 8M10 8 8 5H6M15 8l-3 8"/>',
        clothing: '<path d="M8 3 3 6l2 5 3-1v11h8V10l3 1 2-5-5-3a4 4 0 0 1-8 0z"/>',
        other: '<path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9z"/><circle cx="8" cy="8" r="1.5"/>',
    } -%}
    <svg viewBox="0 0 24 24" aria-hidden="true">{{ (paths[category.value] ?? paths.other)|raw }}</svg>
{%- endmacro %}
