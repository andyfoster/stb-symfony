{% extends 'base.html.twig' %}

{% block title %}ScarfieTextbooks · Buy and sell textbooks with other students{% endblock %}

{% block body %}
    {#
     # Every live listing is on the page; the listing-filter controller shows and hides them as
     # you search, switch tabs or pick categories, without reloading or touching the address bar.
     # Without JavaScript the form submits as a GET and the server applies the same filter.
     #}
    <div class="browse" data-controller="listing-filter view-toggle">
        <section class="hero" aria-labelledby="hero-title">
            <h1 id="hero-title" class="wordmark"><span class="wm-blue">scarfie</span><span class="wm-gold">textbooks</span><span class="wm-blue">.com</span></h1>

            {% do form.type.setRendered() %}
            {{ form_start(form, {attr: {
                id: 'listing-filters',
                class: 'filter-bar',
                role: 'search',
                'aria-label': 'Search listings',
                'data-action': 'listing-filter#apply:prevent',
            }}) }}
                <div class="filter-search">
                    {{ form_label(form.q, null, {label_attr: {class: 'visually-hidden'}}) }}
                    {{ form_widget(form.q, {attr: {'data-listing-filter-target': 'query', 'data-action': 'input->listing-filter#search', autofocus: true}}) }}
                    <button class="filter-submit" type="submit">Search</button>
                </div>
                {{ form_errors(form.q) }}

                <fieldset class="category-pills">
                    <legend class="visually-hidden">Categories</legend>
                    {% for choice in form.categories %}
                        {{ form_widget(choice, {attr: {class: 'pill-input', 'data-listing-filter-target': 'category', 'data-action': 'listing-filter#apply'}}) }}
                        {{ form_label(choice, null, {label_attr: {class: 'pill'}}) }}
                    {% endfor %}
                </fieldset>
                {{ form_errors(form.categories) }}
            {{ form_end(form) }}
        </section>

        <section id="listings" aria-labelledby="listings-title">
            <h2 id="listings-title" class="visually-hidden">Listings</h2>
            <div class="results-bar">
                <div class="tabs" role="radiogroup" aria-label="Show">
                    {% for type in enum_cases('App\\Enum\\ListingType') %}
                        <label class="tab">
                            <input type="radio" name="type" value="{{ type.value }}" form="listing-filters" data-listing-filter-target="type" data-action="listing-filter#apply" {{ filter.type == type ? 'checked' }}>
                            {{ type.label }} <span class="count" data-listing-filter-target="count" data-type="{{ type.value }}">{{ counts[type.value] }}</span>
                        </label>
                    {% endfor %}
                </div>
                <div class="view-switch" role="group" aria-label="View">
                    <button type="button" class="view-button" data-view-toggle-target="button" data-action="view-toggle#choose" data-view-toggle-view-param="list" aria-label="List view" title="List view">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                    </button>
                    <button type="button" class="view-button" data-view-toggle-target="button" data-action="view-toggle#choose" data-view-toggle-view-param="grid" aria-label="Grid view" title="Grid view">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                    </button>
                </div>
            </div>

            {% set shown = listings|filter(listing => filter.matches(listing))|length %}
            <p class="results-note" data-listing-filter-target="note" role="status" {{ filter.narrowed ? '' : 'hidden' }}>
                <span data-listing-filter-target="summary">{{ shown }} {{ shown == 1 ? 'match' : 'matches' }}{% if filter.q %} for “{{ filter.q }}”{% endif %}</span>
                <a class="clear-link" href="{{ path('app_listings', {type: filter.type.value}) }}" data-action="listing-filter#clear:prevent">Clear</a>
            </p>

            <div class="listing-grid">
                {% for listing in listings %}
                    {{ include('listing/_card.html.twig', {hidden: not filter.matches(listing)}) }}
                {% endfor %}

                <div class="empty-state" data-listing-filter-target="empty" {{ shown ? 'hidden' }}>
                    <div data-empty="narrowed" {{ filter.narrowed ? '' : 'hidden' }}>
                        <h3>Nothing matches that.</h3>
                        <p>Try a different search, pick other categories, or look at the other tab.</p>
                        <a class="button" href="{{ path('app_listings', {type: filter.type.value}) }}" data-action="listing-filter#clear:prevent">Clear search</a>
                    </div>
                    <div data-empty="wanted" {{ not filter.narrowed and filter.type.value == 'wanted' ? '' : 'hidden' }}>
                        <h3>Nobody’s asking for anything right now.</h3>
                        <p>Looking for something? Post a wanted listing and sellers can message you.</p>
                        <a class="button" href="{{ path('app_listing_new') }}">Post a wanted listing</a>
                    </div>
                    <div data-empty="for_sale" {{ not filter.narrowed and filter.type.value == 'for_sale' ? '' : 'hidden' }}>
                        <h3>No listings yet.</h3>
                        <p>Listings will show up here once students start posting.</p>
                        <a class="button" href="{{ path('app_listing_new') }}">Post the first one</a>
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
