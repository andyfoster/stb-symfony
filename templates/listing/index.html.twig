{% extends 'base.html.twig' %}

{% block title %}ScarfieTextbooks · Buy and sell textbooks with other students{% endblock %}

{% block body %}
    <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title" class="wordmark"><span class="wm-blue">scarfie</span><span class="wm-gold">textbooks</span><span class="wm-blue">.com</span></h1>

        {{ form_start(form, {attr: {
            class: 'filter-bar',
            role: 'search',
            'aria-label': 'Search listings',
            'data-controller': 'filter-form',
            'data-turbo-frame': 'listings',
            'data-turbo-action': 'advance',
        }}) }}
            <div class="filter-search">{{ form_row(form.q, {label_attr: {class: 'visually-hidden'}, attr: {'data-action': 'input->filter-form#debouncedSubmit', autofocus: true}}) }}</div>
            <div class="filter-options">
                <div class="filter-field">{{ form_row(form.type, {label_attr: {class: 'visually-hidden'}, attr: {'data-action': 'filter-form#submit'}}) }}</div>
                <div class="filter-field">{{ form_row(form.category, {label_attr: {class: 'visually-hidden'}, attr: {'data-action': 'filter-form#submit'}}) }}</div>
                <div class="filter-field filter-price">{{ form_row(form.maxPrice, {label_attr: {class: 'visually-hidden'}, attr: {'data-action': 'input->filter-form#debouncedSubmit', placeholder: 'Max price ($)'}}) }}</div>
                <div class="filter-actions"><button class="button button-outline button-small" type="submit">Filter</button></div>
            </div>
        {{ form_end(form) }}

        <p class="tagline">Buy and sell textbooks with other students. Free, and much easier than a poster on the noticeboard.</p>
    </section>

    <turbo-frame id="listings" data-turbo-action="advance">
        <section aria-labelledby="listings-title">
            <div class="section-heading">
                <h2 id="listings-title"><span class="count">{{ listings|length }}</span> {{ listings|length == 1 ? 'listing' : 'listings' }}{{ filtered ? ' found' : '' }}</h2>
                {% if filtered %}<a class="clear-link" href="{{ path('app_listings') }}" data-turbo-frame="_top">Clear filters</a>{% else %}<span class="sort-note">Newest first</span>{% endif %}
            </div>

            <div class="listing-grid">
                {% for listing in listings %}
                    {{ include('listing/_card.html.twig') }}
                {% else %}
                    <div class="empty-state">
                        {% if filtered %}
                            <h3>Nothing matches those filters.</h3>
                            <p>Try a different search, or widen the category or price.</p>
                            <a class="button" href="{{ path('app_listings') }}" data-turbo-frame="_top">Clear filters</a>
                        {% else %}
                            <h3>No listings yet.</h3>
                            <p>Listings will show up here once students start posting.</p>
                            <a class="button" href="{{ path('app_listing_new') }}" data-turbo-frame="_top">Post the first one</a>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </section>
    </turbo-frame>
{% endblock %}
