{% extends 'base.html.twig' %}

{% block title %}ScarfieTextbooks · Buy and sell textbooks with other students{% endblock %}

{% block body %}
    {# The tabs live inside the results frame (their counts change) but belong to the form, via form="listing-filters". #}
    <div class="browse" data-controller="filter-form view-toggle">
        <section class="hero" aria-labelledby="hero-title">
            <h1 id="hero-title" class="wordmark"><span class="wm-blue">scarfie</span><span class="wm-gold">textbooks</span><span class="wm-blue">.com</span></h1>

            {% do form.type.setRendered() %}
            {{ form_start(form, {attr: {
                id: 'listing-filters',
                class: 'filter-bar',
                role: 'search',
                'aria-label': 'Search listings',
                'data-filter-form-target': 'form',
                'data-turbo-frame': 'listings',
                'data-turbo-action': 'advance',
            }}) }}
                <div class="filter-search">
                    {{ form_label(form.q, null, {label_attr: {class: 'visually-hidden'}}) }}
                    {{ form_widget(form.q, {attr: {'data-action': 'input->filter-form#debouncedSubmit', autofocus: true}}) }}
                    <button class="filter-submit" type="submit">Search</button>
                </div>
                {{ form_errors(form.q) }}

                <fieldset class="category-pills">
                    <legend class="visually-hidden">Categories</legend>
                    {% for choice in form.categories %}
                        {{ form_widget(choice, {attr: {class: 'pill-input', 'data-action': 'filter-form#submit'}}) }}
                        {{ form_label(choice, null, {label_attr: {class: 'pill'}}) }}
                    {% endfor %}
                </fieldset>
                {{ form_errors(form.categories) }}
            {{ form_end(form) }}
        </section>

        <turbo-frame id="listings" data-turbo-action="advance">
            <section aria-labelledby="listings-title">
                <h2 id="listings-title" class="visually-hidden">Listings</h2>
                <div class="results-bar">
                    <div class="tabs" role="radiogroup" aria-label="Show">
                        {% for type in enum_cases('App\\Enum\\ListingType') %}
                            <label class="tab">
                                <input type="radio" name="type" value="{{ type.value }}" form="listing-filters" data-action="filter-form#submit" {{ filter.type == type ? 'checked' }}>
                                {{ type.label }} <span class="count">{{ counts[type.value] }}</span>
                            </label>
                        {% endfor %}
                    </div>
                    <div class="view-switch" role="group" aria-label="View">
                        <button type="button" class="view-button" data-view-toggle-target="button" data-action="view-toggle#choose" data-view-toggle-view-param="list" aria-label="List view" title="List view">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                        </button>
                        <button type="button" class="view-button" data-view-toggle-target="button" data-action="view-toggle#choose" data-view-toggle-view-param="grid" aria-label="Grid view" title="Grid view">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                        </button>
                    </div>
                </div>

                {% if filter.narrowed %}
                    <p class="results-note">
                        {{ listings|length }} {{ listings|length == 1 ? 'match' : 'matches' }}{% if filter.q %} for “{{ filter.q }}”{% endif %}
                        <a class="clear-link" href="{{ path('app_listings', {type: filter.type.value}) }}" data-turbo-frame="_top">Clear</a>
                    </p>
                {% endif %}

                <div class="listing-grid">
                    {% for listing in listings %}
                        {{ include('listing/_card.html.twig') }}
                    {% else %}
                        <div class="empty-state">
                            {% if filter.narrowed %}
                                <h3>Nothing matches that.</h3>
                                <p>Try a different search, or pick other categories{% if counts[filter.type.value == 'wanted' ? 'for_sale' : 'wanted'] %}, or look at the other tab{% endif %}.</p>
                                <a class="button" href="{{ path('app_listings', {type: filter.type.value}) }}" data-turbo-frame="_top">Clear search</a>
                            {% elseif filter.type.value == 'wanted' %}
                                <h3>Nobody’s asking for anything right now.</h3>
                                <p>Looking for something? Post a wanted listing and sellers can message you.</p>
                                <a class="button" href="{{ path('app_listing_new') }}" data-turbo-frame="_top">Post a wanted listing</a>
                            {% else %}
                                <h3>No listings yet.</h3>
                                <p>Listings will show up here once students start posting.</p>
                                <a class="button" href="{{ path('app_listing_new') }}" data-turbo-frame="_top">Post the first one</a>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </section>
        </turbo-frame>
    </div>
{% endblock %}
