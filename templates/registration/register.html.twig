{% extends 'base.html.twig' %}

{% block title %}Sign up · ScarfieTextbooks{% endblock %}

{% block body %}
    <div class="form-page">
        <div class="form-heading">
            <h1>Create an account</h1>
        </div>
        {{ include('security/_old_site_notice.html.twig') }}
        {{ include('security/_google_button.html.twig', {action: 'sign up'}) }}

        {{ form_start(form, {attr: {class: 'form-panel', novalidate: 'novalidate'}}) }}
            <div class="form-field">{{ form_row(form.displayName) }}</div>
            <div class="form-field">{{ form_row(form.email) }}</div>
            <div class="form-field">{{ form_row(form.plainPassword.first) }}</div>
            <div class="form-field">{{ form_row(form.plainPassword.second) }}</div>
            {% if form.children.captcha is defined %}<div class="form-field">{{ form_row(form.captcha) }}</div>{% endif %}
            <div class="form-actions">
                <a class="cancel-link" href="{{ path('app_login') }}">Already have an account? Log in</a>
                <button class="button" type="submit">Sign up</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
