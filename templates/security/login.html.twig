{% extends 'base.html.twig' %}

{% block title %}Log in · ScarfieTextbooks{% endblock %}

{% block body %}
    <div class="form-page col-12 col-md-8 col-lg-5 mx-auto py-4">
        <div class="form-heading mb-4">
            <h1>Log in</h1>
        </div>

        {# Posted to the firewall's form_login; field names match security.yaml. #}
        <form class="form-panel card card-body p-4" method="post" action="{{ path('app_login') }}">
            {% if error %}
                <div class="flash alert alert-danger login-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <div class="form-field mb-3">
                <label class="form-label" for="email">Email</label>
                <input class="form-control" type="email" id="email" name="email" value="{{ last_email }}" autocomplete="email" required autofocus>
            </div>
            <div class="form-field mb-3">
                <label class="form-label" for="password">Password</label>
                <input class="form-control" type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
            <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="remember-me" name="_remember_me"><label class="form-check-label" for="remember-me">Keep me logged in on this device</label></div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <div class="form-actions d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
                <a class="link-secondary" href="{{ path('app_forgot_password') }}">Forgot your password?</a>
                <button class="button btn btn-primary" type="submit">Log in</button>
            </div>
            <p class="form-links d-flex justify-content-between gap-3 mt-3 small">New here? <a href="{{ path('app_register') }}">Create an account</a></p>
        </form>
    </div>
{% endblock %}
