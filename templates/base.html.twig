<!DOCTYPE html>
<html lang="en-NZ">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#ffffff">
        <title>{% block title %}ScarfieTextbooks{% endblock %}</title>
        <link rel="icon" type="image/svg+xml" href="{{ asset('images/favicon.svg') }}">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body data-home="{{ app.request.attributes.get('_route') == 'app_listings' ? 'true' : 'false' }}">
        <a class="skip-link" href="#main">Skip to content</a>
        <header class="site-header">
            <div class="header-inner">
                <a id="site-brand" class="brand {{ app.request.attributes.get('_route') == 'app_listings' ? 'brand-pale' : '' }}" href="{{ path('app_listings') }}" aria-label="ScarfieTextbooks home" data-turbo-permanent data-controller="brand" data-action="turbo:load@document->brand#update"><span class="wm-blue" aria-hidden="true">s<span class="brand-remainder">carfie</span></span><span class="wm-gold" aria-hidden="true">t<span class="brand-remainder">extbooks</span></span></a>
                <nav class="main-nav" aria-label="Main">
                    <a class="main-link" href="{{ path('app_listings') }}">Browse</a>
                    <a class="main-link" href="{{ path('app_listing_new') }}">Sell</a>
                </nav>
                <nav class="site-nav" aria-label="Account">
                    {% if app.user %}
                        {% set unread = unread_message_count() %}
                        <details class="nav-menu" data-controller="nav-menu" data-action="click@window->nav-menu#closeOutside keydown.esc@window->nav-menu#close">
                            <summary class="nav-user">
                                {{ app.user.displayName }}
                                {% if unread %}<span class="nav-badge" aria-label="{{ unread }} unread">{{ unread }}</span>{% endif %}
                            </summary>
                            <ul class="nav-menu-list">
                                <li><a href="{{ path('app_account') }}">Dashboard</a></li>
                                <li><a href="{{ path('app_account_listings') }}">My listings</a></li>
                                <li><a href="{{ path('app_account_messages') }}">Messages{% if unread %} <span class="nav-badge">{{ unread }}</span>{% endif %}</a></li>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li><a class="nav-admin" href="{{ path('admin') }}" data-turbo="false">Admin</a></li>
                                {% endif %}
                                <li>
                                    <form method="post" action="{{ path('app_logout') }}">
                                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                                        <button class="nav-link" type="submit">Log out</button>
                                    </form>
                                </li>
                            </ul>
                        </details>
                    {% else %}
                        <a class="nav-link" href="{{ path('app_login') }}">Log in</a>
                        <a class="button button-small" href="{{ path('app_register') }}">Sign up</a>
                    {% endif %}
                </nav>
            </div>
        </header>
        <main id="main" class="page-shell">
            <div class="toasts">
                {% for message in app.flashes('success') %}
                    <div class="flash toast" role="status" data-controller="toast">
                        <span>{{ message }}</span>
                        <button class="toast-close" type="button" data-action="toast#close" aria-label="Dismiss">×</button>
                    </div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="flash flash-error toast" role="alert" data-controller="toast" data-toast-delay-value="9000">
                        <span>{{ message }}</span>
                        <button class="toast-close" type="button" data-action="toast#close" aria-label="Dismiss">×</button>
                    </div>
                {% endfor %}
            </div>
            {% if app.user and not app.user.verified %}
                <form class="flash flash-notice" method="post" action="{{ path('app_verify_resend') }}">
                    <span>Please confirm your email address. Check your inbox for the link we sent to {{ app.user.email }}.</span>
                    <input type="hidden" name="_token" value="{{ csrf_token('resend-verification') }}">
                    <button class="nav-link" type="submit">Send it again</button>
                </form>
            {% endif %}
            {% block body %}{% endblock %}
        </main>
        <footer class="site-footer">
            <div class="footer-inner">
                <span>© {{ 'now'|date('Y') }} ScarfieTextbooks. Free for students, no fees.</span>
                <span>The 21st-century alternative to posters on noticeboards.</span>
            </div>
        </footer>
    </body>
</html>
