<!DOCTYPE html>
<html lang="en-NZ">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#ffffff">
        <title>{% block title %}ScarfieTextbooks{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230b3a9f'/%3E%3Cpath d='M32 14 6 26l26 12 26-12z' fill='%23ffcd00'/%3E%3Cpath d='M17 32v10c0 4 7 8 15 8s15-4 15-8V32l-15 7z' fill='%23ffcd00'/%3E%3C/svg%3E">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% block importmap %}{{ importmap('app') }}{% endblock %}{% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        <a class="visually-hidden-focusable position-absolute top-0 start-0 bg-white p-2 z-3" href="#main">Skip to content</a>
        <header class="site-header border-bottom">
            <div class="header-inner container d-flex align-items-center gap-3 py-3">
                <a class="brand text-decoration-none font-monospace fs-4 fw-semibold me-sm-3" href="{{ path('app_listings') }}"><span class="wm-blue">s</span><span class="wm-gold">t</span></a>
                <nav class="main-nav d-flex gap-3" aria-label="Main">
                    <a class="text-decoration-none text-body-secondary" href="{{ path('app_listings') }}">Browse</a>
                    <a class="text-decoration-none text-body-secondary" href="{{ path('app_listing_new') }}">Sell</a>
                </nav>
                <nav class="site-nav d-flex align-items-center gap-3 ms-auto" aria-label="Account">
                    {% if app.user %}
                        {% set unread = unread_message_count() %}
                        <div class="dropdown">
                            <button class="nav-user btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{ app.user.displayName }}
                                {% if unread %}<span class="nav-badge badge text-bg-primary rounded-pill" aria-label="{{ unread }} unread">{{ unread }}</span>{% endif %}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="{{ path('app_account') }}">Dashboard</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_account_listings') }}">My listings</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_account_messages') }}">Messages{% if unread %} <span class="nav-badge badge text-bg-primary rounded-pill">{{ unread }}</span>{% endif %}</a></li>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li><a class="nav-admin dropdown-item" href="{{ path('admin') }}" data-turbo="false">Admin</a></li>
                                {% endif %}
                                <li>
                                    <form method="post" action="{{ path('app_logout') }}">
                                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                                        <button class="dropdown-item" type="submit">Log out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    {% else %}
                        <a class="nav-link" href="{{ path('app_login') }}">Log in</a>
                        <a class="button btn btn-primary btn-sm" href="{{ path('app_register') }}">Sign up</a>
                    {% endif %}
                </nav>
            </div>
        </header>
        <main id="main" class="page-shell container flex-grow-1">
            <div class="toast-container position-fixed bottom-0 start-0 p-3">
                {% for message in app.flashes('success') %}
                    <div class="flash toast border-success" role="status" data-controller="toast">
                        <div class="d-flex"><div class="toast-body">{{ message }}</div>
                        <button class="btn-close m-2 ms-auto" type="button" data-action="toast#close" aria-label="Dismiss"></button></div>
                    </div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="flash flash-error toast border-danger" role="alert" data-controller="toast" data-toast-delay-value="9000">
                        <div class="d-flex"><div class="toast-body">{{ message }}</div>
                        <button class="btn-close m-2 ms-auto" type="button" data-action="toast#close" aria-label="Dismiss"></button></div>
                    </div>
                {% endfor %}
            </div>
            {% if app.user and not app.user.verified %}
                <form class="flash flash-notice alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3" method="post" action="{{ path('app_verify_resend') }}">
                    <span>Please confirm your email address. Check your inbox for the link we sent to {{ app.user.email }}.</span>
                    <input type="hidden" name="_token" value="{{ csrf_token('resend-verification') }}">
                    <button class="btn btn-link p-0" type="submit">Send it again</button>
                </form>
            {% endif %}
            {% block body %}{% endblock %}
        </main>
        <footer class="site-footer border-top mt-5 text-body-secondary small">
            <div class="footer-inner container d-flex flex-wrap justify-content-between gap-2 py-4">
                <span>© {{ 'now'|date('Y') }} ScarfieTextbooks. Free for students, no fees.</span>
                <span>The 21st-century alternative to posters on noticeboards.</span>
            </div>
        </footer>
    </body>
</html>
