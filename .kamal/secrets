# Production secrets for Kamal, fetched from 1Password at deploy time.
# This file only holds references, never values, so it is safe to commit.
#
# 1Password: account my.1password.ca, vault "Private", item "ScarfieTextbooks-production",
# with fields named APP_SECRET, POSTGRES_PASSWORD, MAILER_DSN, TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY
# (MAILER_DSN is the Mailgun DSN, e.g. mailgun+api://KEY:mg.example.com@default?region=eu;
# the TURNSTILE_* fields are the Cloudflare Turnstile widget's site key and secret key).
# Requires the 1Password CLI (`op`), with CLI integration enabled in the 1Password app.

SECRETS=$(kamal secrets fetch --adapter 1password --account my.1password.ca --from Private/ScarfieTextbooks-production APP_SECRET POSTGRES_PASSWORD MAILER_DSN TURNSTILE_SITE_KEY TURNSTILE_SECRET_KEY)

APP_SECRET=$(kamal secrets extract APP_SECRET $SECRETS)
POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD $SECRETS)
MAILER_DSN=$(kamal secrets extract MAILER_DSN $SECRETS)
TURNSTILE_SITE_KEY=$(kamal secrets extract TURNSTILE_SITE_KEY $SECRETS)
TURNSTILE_SECRET_KEY=$(kamal secrets extract TURNSTILE_SECRET_KEY $SECRETS)

# The app connects to the stb-db accessory (config/deploy.yml) with the same password.
DATABASE_URL="postgresql://stb:${POSTGRES_PASSWORD}@stb-db:5432/stb?serverVersion=18&charset=utf8"
